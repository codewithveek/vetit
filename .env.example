# Copy to .env and fill in what you need. Every value below has a working
# default, so an empty .env — or no .env at all — still starts both servers.
#
# .env is gitignored. Nothing in this project writes a secret anywhere or
# prints one, and Vetit never stores a target's credential: keys go to the
# TrueForge harness, which resolves them server-side.

# --- TrueForge ---------------------------------------------------------------

# Where the harness is. Leave as-is for a local instance.
TRUEFORGE_BASE_URL=http://localhost:8790

# Start TrueForge as part of setup, if nothing is already answering above.
# It is fetched with npx, so the first run downloads it.
START_TRUEFORGE=false

# TrueForge needs two things configured before it will create the agent:
#   * a model provider, for the model in agent/vetit-agent.json
#   * a sandbox provider, because the review playbook is a git-backed skill
#     and skills are materialised in a sandbox
# Both are set in TrueForge's own settings, not here. macOS and Linux get a
# local sandbox automatically; Windows has no local provider and needs one.

# --- Optional: the advisory cross-check --------------------------------------

# Without this the agent is created with no exa connector. Every other pass
# still runs, and the report says the cross-check was not performed.
EXA_API_KEY=

# --- Ports -------------------------------------------------------------------

VETIT_PORT=8930
DECOY_PORT=8931
VETIT_COLLECTOR_PORT=8999

# --- Reaching things ---------------------------------------------------------

# The address TrueForge is told to reach the servers on. Loopback is right when
# TrueForge runs on this machine. A TrueForge in a container needs an address
# meaning "the host" — host.docker.internal on Docker Desktop — or every
# connector it registers points at itself.
VETIT_ADVERTISED_HOST=127.0.0.1

# The address a *target* can reach the tripwire collector on. The bundled decoy
# runs on this machine, so loopback works. A target on another host or in a
# container needs an address it can actually call, or egress is reported as
# not observed rather than as clean.
VETIT_COLLECTOR_PUBLIC_URL=

# Planted in the probe's arguments where a thief would look, and matched
# against anything arriving at the collector. Deliberately worthless.
VETIT_CANARY_VALUE=vetit-canary-not-a-real-secret

# --- The skill ---------------------------------------------------------------

# The playbook is registered from git, so TrueForge needs a repository to fetch
# it from. Both default to this checkout's origin and current branch — and the
# branch has to be pushed, or the skill will not resolve.
VETIT_SKILL_REPO_URL=
VETIT_SKILL_REF=

# Seconds to wait for each server to answer before giving up.
VETIT_STARTUP_TIMEOUT=60
